<%- include("../partials/head") %>
<%- include("../partials/header") %>

<main id="main-content">
  <h1 class="page-title">Projects</h1>
  <p class="page-subtitle">Klik op een project voor meer informatie</p>

  <ul class="collections-grid" role="list" aria-label="Projectenlijst">
    <% projects.forEach(project => { %>
      <li class="collection-item">
        <article class="collection-card">
          <% if (project.external) { %>
            <a href="<%= project.url %>" target="_blank" rel="noopener noreferrer" aria-label="<%= project.title %> (opent in nieuw tabblad)">
          <% } else { %>
            <a href="<%= project.url %>">
          <% } %>
            <figure>
  <img 
    src="<%= project.image %>" 
    alt="<%= project.title %>" 
    class="card-thumb"
  />
  <figcaption class="card-body">
    <h2><%= project.title %></h2>
    <p><%= project.description %></p>
    <% if (project.tags && project.tags.length) { %>
      <ul class="card-tags" role="list" aria-label="technologies">
        <% project.tags.forEach(tag => { %>
          <li><span class="card-tag"><%= tag %></span></li>
        <% }) %>
      </ul>
    <% } %>
  </figcaption>
</figure>
          </a>
        </article>
      </li>
    <% }) %>
  </ul>
</main>

<%- include("../partials/footer") %>